# Copy this file to ".env" and fill in your Supabase project values.
#
# If BOTH variables are left blank / missing, the app automatically runs in
# DEMO MODE using the browser's localStorage (no backend, single device).
# Fill these in to switch to real multi-device / realtime / login mode.
#
# Find these under: Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
